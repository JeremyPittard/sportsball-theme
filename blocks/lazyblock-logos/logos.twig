<section x-data="{ show: false }">
	{% if attributes.full_width %}
		<div class="relative items-center w-full px-5 py-12 lg:py-24 mx-auto md:px-12 lg:px-16 ">
		{% else %}
			<div class="relative items-center w-full px-5 py-12 lg:py-24 mx-auto md:px-12 lg:px-16 max-w-7xl">
			{% endif %}
			{% if attributes.title %}
				<h2 class="sb-heading text-center">{{attributes.title}}</h2>
			{% endif %}
			{% if attributes.subtitle %}
				<p class="text-xl text-center mx-auto max-w-2xl">{{attributes.subtitle}}</p>
			{% endif %}
			<div class="flex flex-wrap gap-0.5 gap-y-12 justify-center duration-500 delay-300 pt-8" :class="show || 'opacity-0'" x-intersect="show = true">
				{% if attributes.tier != '999' %}
					{% for logo in logos | filter((logo) => logo.tier == attributes.tier) %}
						{% if logo.url %}
							<a href="{{logo.url.url}}" target="_blank" rel="noopener noreferrer" class="flex justify-center w-[45%] md:w-[16.5%] px-8">
								<img class="max-w-full h-auto object-contain max-h-20" src="{{Image(logo.logo).src}}" alt="{{logo.title}}">
							</a>
						{% else %}
							<div class="flex justify-center col-span-1 px-8 w-[45%] md:w-[16.5%]">
								<img class="max-w-full h-auto object-contain max-h-20" src="{{Image(logo.logo).src}}" alt="{{logo.title}}">
							</div>
						{% endif %}
					{% endfor %}
				{% else  %}
					{% for logo in logos %}
						{% if logo.url %}
							<a href="{{logo.url.url}}" target="_blank" rel="noopener noreferrer" class="flex justify-center w-[45%] md:w-[16.5%] px-8">
								<img class="max-w-full h-auto object-contain max-h-20" src="{{Image(logo.logo).src}}" alt="{{logo.title}}">
							</a>
						{% else %}
							<div class="flex justify-center col-span-1 px-8 w-[45%] md:w-[16.5%]">
								<img class="max-w-full h-auto object-contain max-h-20" src="{{Image(logo.logo).src}}" alt="{{logo.title}}">
							</div>
						{% endif %}
					{% endfor %}
				{% endif %}
			</div>
		</div>
	</section>
